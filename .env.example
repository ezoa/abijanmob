# AbidjanMob — modèle de configuration d'environnement
#
# Copier ce fichier en `.env` (démo/développement) puis adapter les valeurs :
#   cp .env.example .env
# Le docker-compose lit automatiquement `.env` au même niveau.
#
# ⚠️ Ne JAMAIS committer les fichiers .env / .env.prod (déjà dans .gitignore).
# ⚠️ Les identifiants PostgreSQL ne s'appliquent qu'à la PREMIÈRE initialisation
#    du volume `pgdata`. Changer le mot de passe plus tard nécessite soit un
#    nouveau volume (données perdues), soit un ALTER USER manuel (make psql).

# ---- Base analytics (PostgreSQL) ----
POSTGRES_USER=abidjanmob
POSTGRES_PASSWORD=abidjanmob
POSTGRES_DB=abidjanmob

# ---- Ports publiés sur la machine ----
API_PORT=8000        # API FastAPI (Swagger : http://localhost:8000/docs)
WEB_PORT=8080        # Interface web (nginx)
METABASE_PORT=3000   # Tableaux de bord décideurs

# ---- Réservé au MVP (NON utilisé par le prototype) ----
# Les clés PSP réelles (Wave, Orange Money…) vivront dans le gestionnaire de
# secrets du VPS, jamais dans un fichier committé.
# WAVE_API_KEY=
# ORANGE_MONEY_API_KEY=
